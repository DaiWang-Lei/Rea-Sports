{
  "name": "rea-sports",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "体感乒乓球（Joy-Con + WebHID），手感对标 Wii Sports Resort 乒乓球的净室重做",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sim.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "soak": "tsx scripts/soak.ts",
    "bench:solver": "tsx scripts/bench-solver.ts",
    "smoke:phone": "tsx scripts/smoke-phone.ts",
    "shot": "tsx scripts/shot.ts",
    "smoke:mqtt": "tsx scripts/smoke-mqtt.ts",
    "smoke:rtc": "tsx scripts/smoke-rtc.ts",
    "analyze:imu": "tsx scripts/analyze-imu.ts",
    "smoke:practice": "tsx scripts/smoke-practice.ts",
    "smoke:practice-phone": "tsx scripts/smoke-practice-phone.ts",
    "eval:swing": "tsx scripts/eval-swing.ts",
    "analyze:practice": "tsx scripts/analyze-practice.ts"
  },
  "dependencies": {
    "lil-gui": "^0.21.0",
    "qrcode": "^1.5.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.186.0",
    "@types/w3c-web-hid": "^1.0.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "playwright-core": "^1.64.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.12",
    "ws": "^8.22.0"
  }
}
